// 1. TOKEN DEFINITIONS

enum class TokenType {
    INTEGER, IDENTIFIER, INTEGER_LITERAL, ASSIGNMENT,
    PTR, PLUS, MINUS, MULTIPLY, DIVIDE,
    LEFT_PAREN, RIGHT_PAREN, EOF_TOKEN, UNKNOWN
};

struct Token {
    TokenType type;
    std::string value;
    int line;

    std::string toString() const {
        if (value.empty()) {
            return "< \"" + tokenTypeToString(type) + "\" >";
        }
        return "< \"" + tokenTypeToString(type) + " , " + value + "\" >";
    }

private:
    std::string tokenTypeToString(TokenType t) const {
        switch (t) {
            case TokenType::INTEGER: return "INTEGER";
            case TokenType::IDENTIFIER: return "IDENTIFIER";
            case TokenType::INTEGER_LITERAL: return "INTEGER_LITERAL";
            case TokenType::ASSIGNMENT: return "ASSIGNMENT";
            case TokenType::PTR: return "Ptr";
            case TokenType::PLUS: return "PLUS";
            case TokenType::MINUS: return "MINUS";
            case TokenType::MULTIPLY: return "MULTIPLY";
            case TokenType::DIVIDE: return "DIVIDE";
            case TokenType::LEFT_PAREN: return "LEFT_PAREN";
            case TokenType::RIGHT_PAREN: return "RIGHT_PAREN";
            case TokenType::EOF_TOKEN: return "EOF";
            default: return "UNKNOWN";
        }
    }
};


// 2. LEXER

class Lexer {
private:
    std::string code;
    size_t pos;
    int line;
    std::vector<Token> tokens;

    char peek() { return (pos < code.length()) ? code[pos] : '\0'; }
    
    char advance() {
        char c = peek();
        if (c == '\n') line++;
        pos++;
        return c;
    }

    void skipWhitespaceAndComments() {
        while (std::isspace(peek())) advance();
        if (peek() == '#') {
            while (peek() != '\0' && peek() != '\n') advance();
        }
    }

public:
    Lexer(const std::string& src) : code(src), pos(0), line(1) {}

    std::vector<Token> tokenize() {
        while (peek() != '\0') {
            skipWhitespaceAndComments();
            if (peek() == '\0') break;
            char ch = peek();

            if (std::isdigit(ch)) {
                std::string num = "";
                while (std::isdigit(peek())) num += advance();
                tokens.push_back({TokenType::INTEGER_LITERAL, num, line});
            } 
            else if (std::isalpha(ch) || ch == '_') {
                std::string word = "";
                while (std::isalnum(peek()) || peek() == '_') word += advance();
                if (word == "integer") tokens.push_back({TokenType::INTEGER, "", line});
                else if (word == "ptr") tokens.push_back({TokenType::PTR, "", line});
                else tokens.push_back({TokenType::IDENTIFIER, word, line});
            } 
            else if (ch == ':') { tokens.push_back({TokenType::ASSIGNMENT, ":", line}); advance(); }
            else if (ch == '+') { tokens.push_back({TokenType::PLUS, "+", line}); advance(); }
            else if (ch == '-') { tokens.push_back({TokenType::MINUS, "-", line}); advance(); }
            else if (ch == '*') { tokens.push_back({TokenType::MULTIPLY, "*", line}); advance(); }
            else if (ch == '/') { tokens.push_back({TokenType::DIVIDE, "/", line}); advance(); }
            else if (ch == '(') { tokens.push_back({TokenType::LEFT_PAREN, "(", line}); advance(); }
            else if (ch == ')') { tokens.push_back({TokenType::RIGHT_PAREN, ")", line}); advance(); }
            else {
                std::cerr << "LexerError: Illegal char '" << ch << "' at line " << line << "\n";
                while (peek() != '\0' && peek() != '\n') advance();
            }
        }
        tokens.push_back({TokenType::EOF_TOKEN, "", line});
        return tokens;
    }
};


// 3. AST NODES

struct ASTNode {
    virtual ~ASTNode() = default;
};

struct IntNode : public ASTNode {
    std::string value;
    IntNode(std::string v) : value(v) {}
};

struct IdNode : public ASTNode {
    std::string value;
    IdNode(std::string v) : value(v) {}
};

struct BinOpNode : public ASTNode {
    std::string op;
    std::unique_ptr<ASTNode> left;
    std::unique_ptr<ASTNode> right;
    BinOpNode(std::string o, std::unique_ptr<ASTNode> l, std::unique_ptr<ASTNode> r) 
        : op(o), left(std::move(l)), right(std::move(r)) {}
};

struct DecNode : public ASTNode {
    std::string type;
    std::string id;
    std::unique_ptr<ASTNode> val;
    DecNode(std::string t, std::string i, std::unique_ptr<ASTNode> v = nullptr) 
        : type(t), id(i), val(std::move(v)) {}
};

struct AssignNode : public ASTNode {
    std::string id;
    std::unique_ptr<ASTNode> val;
    AssignNode(std::string i, std::unique_ptr<ASTNode> v) : id(i), val(std::move(v)) {}
};

struct PrtNode : public ASTNode {
    std::unique_ptr<ASTNode> expr;
    PrtNode(std::unique_ptr<ASTNode> e) : expr(std::move(e)) {}
};

struct ProgNode : public ASTNode {
    std::vector<std::unique_ptr<ASTNode>> stmts;
    void addStmt(std::unique_ptr<ASTNode> s) { stmts.push_back(std::move(s)); }
};


// 4. PARSER

class Parser {
private:
    std::vector<Token> tokens;
    size_t pos;

    Token current() { return (pos < tokens.size()) ? tokens[pos] : tokens.back(); }
    void advance() { if (pos < tokens.size()) pos++; }
    bool match(TokenType type) {
        if (current().type == type) { advance(); return true; }
        return false;
    }

    std::unique_ptr<ASTNode> factor() {
        if (match(TokenType::INTEGER_LITERAL)) {
            return std::make_unique<IntNode>(tokens[pos-1].value);
        } else if (match(TokenType::IDENTIFIER)) {
            return std::make_unique<IdNode>(tokens[pos-1].value);
        } else if (match(TokenType::LEFT_PAREN)) {
            auto node = expr();
            if (!match(TokenType::RIGHT_PAREN)) {
                throw std::runtime_error("Parse Error: Expected ')' at line " + std::to_string(current().line));
            }
            return node;
        }
        throw std::runtime_error("Parse Error: Unexpected token '" + current().value + "' at line " + std::to_string(current().line));
    }

    std::unique_ptr<ASTNode> term() {
        auto left = factor();
        while (current().type == TokenType::MULTIPLY || current().type == TokenType::DIVIDE) {
            std::string op = (current().type == TokenType::MULTIPLY) ? "MULTIPLY" : "DIVIDE";
            advance();
            auto right = factor();
            left = std::make_unique<BinOpNode>(op, std::move(left), std::move(right));
        }
        return left;
    }

    std::unique_ptr<ASTNode> expr() {
        auto left = term();
        while (current().type == TokenType::PLUS || current().type == TokenType::MINUS) {
            std::string op = (current().type == TokenType::PLUS) ? "PLUS" : "MINUS";
            advance();
            auto right = term();
            left = std::make_unique<BinOpNode>(op, std::move(left), std::move(right));
        }
        return left;
    }

    std::unique_ptr<ASTNode> stmt() {
        if (current().type == TokenType::INTEGER) {
            advance();
            std::string id = current().value;
            advance();
            std::unique_ptr<ASTNode> val = nullptr;
            if (match(TokenType::ASSIGNMENT)) {
                val = expr();
            }
            return std::make_unique<DecNode>("integer", id, std::move(val));
        } 
        else if (current().type == TokenType::IDENTIFIER) {
            std::string id = current().value;
            advance();
            if (match(TokenType::ASSIGNMENT)) {
                auto val = expr();
                return std::make_unique<AssignNode>(id, std::move(val));
            }
            throw std::runtime_error("Parse Error: Expected ':' after identifier at line " + std::to_string(current().line));
        } 
        else if (current().type == TokenType::PTR) {
            advance();
            return std::make_unique<PrtNode>(expr());
        }
        throw std::runtime_error("Parse Error: Unexpected statement at line " + std::to_string(current().line));
    }

public:
    Parser(std::vector<Token> t) : tokens(t), pos(0) {}

    std::unique_ptr<ProgNode> parse() {
        auto program = std::make_unique<ProgNode>();
        while (current().type != TokenType::EOF_TOKEN) {
            program->addStmt(stmt());
        }
        return program;
    }
};

// 5. SYMBOL TABLE (Advanced - Matches Python)

struct Symbol {
    std::string name;
    std::string type;
    std::string value;
    bool is_init;

    Symbol(std::string n, std::string t, std::string v = "", bool init = false) 
        : name(n), type(t), value(v), is_init(init) {
        if (!value.empty()) is_init = true;
    }

    std::string toString() const {
        std::string status = is_init ? "initialized" : "uninitialized";
        return name + ", " + type + ", " + status;
    }
};

class SymbolTable {
private:
    std::unordered_map<std::string, Symbol> vars;

public:
    std::pair<bool, std::string> define(const std::string& name, const std::string& type, const std::string& value = "") {
        if (vars.count(name)) {
            return {false, "'" + name + "' is already declared!"};
        }
        vars[name] = Symbol(name, type, value);
        return {true, ""};
    }

    std::pair<bool, std::string> update(const std::string& name, const std::string& value) {
        if (!vars.count(name)) {
            return {false, name + " is not declared!"};
        }
        vars[name].value = value;
        vars[name].is_init = true;
        return {true, ""};
    }

    Symbol* lookup(const std::string& name) {
        if (vars.count(name)) {
            return &vars[name];
        }
        return nullptr;
    }

    bool is_defined(const std::string& name) {
        return vars.count(name) > 0;
    }

    bool is_initialized(const std::string& name) {
        if (vars.count(name)) {
            return vars[name].is_init;
        }
        return false;
    }

    void printSymbols() const {
        std::cout << std::string(62, '-') << "\n";
        std::cout << std::left << std::setw(12) << "var-name" << "\t\t"
                  << std::setw(12) << "var-type" << "\t\t"
                  << "is_initialized\n";
        std::cout << std::string(62, '-') << "\n";
        for (const auto& pair : vars) {
            std::string status = pair.second.is_init ? "initialized" : "uninitialized";
            std::cout << std::left << std::setw(12) << pair.second.name << "\t\t"
                      << std::setw(12) << pair.second.type << "\t\t"
                      << status << "\n";
        }
    }

    std::string toString() const {
        std::string result = "Symbol Table:\n" + std::string(40, '-') + "\n";
        result += std::left << std::setw(12) << "Name" << " " 
                  << std::setw(10) << "Type" << " " 
                  << std::setw(14) << "Status" + "\n";
        result += std::string(40, '-') + "\n";
        for (const auto& pair : vars) {
            std::string status = pair.second.is_init ? "initialized" : "uninitialized";
            result += std::left << std::setw(12) << pair.second.name << " " 
                      << std::setw(10) << pair.second.type << " " 
                      << status + "\n";
        }
        return result;
    }
};


// 6. SEMANTIC ANALYZER (Advanced - Matches Python)

class SemanticAnalyzer {
private:
    SymbolTable symtab;
    std::vector<std::string> errors;

    std::string analyzeExpr(const ASTNode* node) {
        if (auto n = dynamic_cast<const IdNode*>(node)) {
            Symbol* x = symtab.lookup(n->value);
            if (!x) {
                errors.push_back("Variable '" + n->value + "' used but not declared");
                return "";
            }
            if (!x->is_init) {
                errors.push_back("Variable '" + n->value + "' used but not initialized");
                return x->type;
            }
            return x->type;
        } 
        else if (auto n = dynamic_cast<const IntNode*>(node)) {
            return "integer";
        } 
        else if (auto n = dynamic_cast<const BinOpNode*>(node)) {
            std::string left_type = analyzeExpr(n->left.get());
            std::string right_type = analyzeExpr(n->right.get());
            if (left_type != "integer" || right_type != "integer") {
                errors.push_back("Type mismatch: '" + n->op + "' between '" + left_type + "' and '" + right_type + "'");
                return "";
            }
            if (left_type == "integer" && right_type == "integer") {
                return "integer";
            }
            return "";
        }
        return "";
    }

    void analyzeDec(const DecNode* node) {
        if (node->type != "integer") {
            errors.push_back("Variable '" + node->id + "' with Unknown Type '" + node->type + "'");
            return;
        }
        auto [ok, err] = symtab.define(node->id, node->type);
        if (!ok) {
            errors.push_back(err);
            return;
        }
        if (node->val) {
            std::string expr_type = analyzeExpr(node->val.get());
            if (!expr_type.empty() && expr_type != "integer") {
                errors.push_back("Type mismatch: '" + node->id + "' declared as 'integer' but assigned '" + expr_type + "'");
                return;
            }
            symtab.update(node->id, "value");
        }
    }

    void analyzeAssign(const AssignNode* node) {
        if (symtab.is_defined(node->id)) {
            std::string expr_type = analyzeExpr(node->val.get());
            if (!expr_type.empty() && expr_type != "integer") {
                errors.push_back("Type mismatch: '" + node->id + "' declared as 'integer' but assigned '" + expr_type + "'");
            }
            symtab.update(node->id, "value");
        }
    }

    void analyzePrt(const PrtNode* node) {
        analyzeExpr(node->expr.get());
    }

    void analyzeStmt(const ASTNode* node) {
        if (auto n = dynamic_cast<const DecNode*>(node)) {
            analyzeDec(n);
        } 
        else if (auto n = dynamic_cast<const AssignNode*>(node)) {
            analyzeAssign(n);
        } 
        else if (auto n = dynamic_cast<const PrtNode*>(node)) {
            analyzePrt(n);
        } 
        else {
            analyzeExpr(node);
        }
    }

public:
    std::pair<SymbolTable, std::vector<std::string>> analyze(const ProgNode* program) {
        for (const auto& stmt : program->stmts) {
            analyzeStmt(stmt.get());
        }
        return {symtab, errors};
    }
};


// 7. AST PRINTER

void printAST(const ASTNode* node, int depth = 0) {
    std::string prefix(depth * 3, '-');
    
    if (auto n = dynamic_cast<const ProgNode*>(node)) {
        std::cout << "Program\n";
        for (const auto& s : n->stmts) {
            std::cout << depth;
            printAST(s.get(), depth + 1);
        }
    } 
    else if (auto n = dynamic_cast<const DecNode*>(node)) {
        std::cout << prefix << "Declare(" << n->type << ")\n";
        std::cout << prefix << "---" << n->id << "\n";
        if (n->val) {
            printAST(n->val.get(), depth + 1);
        }
    } 
    else if (auto n = dynamic_cast<const AssignNode*>(node)) {
        std::cout << prefix << "Assign\n";
        std::cout << prefix << "---" << n->id << "\n";
        printAST(n->val.get(), depth + 1);
    } 
    else if (auto n = dynamic_cast<const PrtNode*>(node)) {
        std::cout << prefix << "Print\n";
        printAST(n->expr.get(), depth + 1);
    } 
    else if (auto n = dynamic_cast<const BinOpNode*>(node)) {
        std::cout << prefix << n->op << "\n";
        printAST(n->left.get(), depth + 1);
        printAST(n->right.get(), depth + 1);
    } 
    else if (auto n = dynamic_cast<const IntNode*>(node)) {
        std::cout << prefix << n->value << "\n";
    } 
    else if (auto n = dynamic_cast<const IdNode*>(node)) {
        std::cout << prefix << n->value << "\n";
    }
}

// 8. MAIN FUNCTION (DEMO with your exact test case)

int main() {
    std::string sourceCode = R"(
integer a 
integer b : a + 20
integer a : 10
integer c : a + 2
b : b - 5
b : a+b*c+(d-10)
ptr b
)";

    std::cout << "SOURCE CODE:\n" << sourceCode << "\n";

    try {
        // 1. Lexical Analysis
        std::cout << "\n--- TOKENS ---\n";
        Lexer lexer(sourceCode);
        std::vector<Token> tokens = lexer.tokenize();
        for (const auto& token : tokens) {
            std::cout << token.toString() << "\n";
        }

        // 2. Parsing
        std::cout << "\n--- AST ---\n";
        Parser parser(tokens);
        std::unique_ptr<ProgNode> ast = parser.parse();
        printAST(ast.get());

        std::cout << "\n--- PARSED PROGRAM ---\n";
        std::cout << "program{\n";
        for (const auto& stmt : ast->stmts) {
            if (auto n = dynamic_cast<const DecNode*>(stmt.get())) {
                std::cout << "declare(" << n->type << " " << n->id;
                if (n->val) std::cout << " : <expr>";
                std::cout << ")\n";
            } 
            else if (auto n = dynamic_cast<const AssignNode*>(stmt.get())) {
                std::cout << "assign(" << n->id << " : <expr>)\n";
            } 
            else if (auto n = dynamic_cast<const PrtNode*>(stmt.get())) {
                std::cout << "print(<expr>)\n";
            }
        }
        std::cout << "}\n";

        // 3. Semantic Analysis
        std::cout << "\n--- SEMANTIC ANALYSIS ---\n";
        SemanticAnalyzer analyzer;
        auto [symtab, errors] = analyzer.analyze(ast.get());
        std::cout << symtab.toString() << "\n";

        if (!errors.empty()) {
            std::cout << "\nERRORS:\n";
            for (const auto& err : errors) {
                std::cout << " " << err << "\n";
            }
        } 
        else {
            std::cout << "\nNo semantic errors found!\n";
        }

        std::cout << "\n✅ Compiler Frontend Completed Successfully!\n";

    } catch (const std::exception& e) {
        std::cerr << "\n❌ ERROR: " << e.what() << "\n";
    }

    return 0;
}
