#include <iostream>
#include <string>
#include <vector>
#include <cctype>

using namespace std;


// Token Types (Global Variables)

string INTEGER = "INTEGER";
string IDENTIFIER = "IDENTIFIER";
string INTEGER_LITERAL = "INTEGER_LITERAL";
string ASSIGNMENT = "ASSIGNMENT";
string PRINT = "Ptr";
string PLUS = "PLUS";
string MINUS = "MINUS";
string MULTIPLY = "MULTIPLY";
string DIVIDE = "DIVIDE";
string LEFT_PAREN = "LEFT_PAREN";
string RIGHT_PAREN = "RIGHT_PAREN";
string EOF_TOKEN = "EOF";

// Token Class

class Token {
public:
    string type_;
    string value;
    int line;

    Token(string t, string v, int l) {
        type_ = t;
        value = v;
        line = l;
    }

    void print() {
        if (value == "") {
            cout << "< " << type_ << " >" << endl;
        } else {
            cout << "< " << type_ << " , " << value << " >" << endl;
        }
    }
};


// Lexer Class

class Lexer {
public:
    string code;
    int pos;
    int line;
    vector<Token> tokens;

    Lexer(string src) {
        code = src;
        pos = 0;
        line = 1;
    }

    char getChar() {
        if (pos < code.length()) {
            return code[pos];
        }
        return '\0';
    }

    void advance() {
        if (getChar() == '\n') {
            line++;
        }
        pos++;
    }

    vector<Token> tokenize() {
        while (true) {
            char c = getChar();

            if (c == '\0') {
                break;
            }
            else if (c == ' ' || c == '\t' || c == '\n') {
                advance();
            }
            else if (c == '#') {
                while (getChar() != '\0' && getChar() != '\n') {
                    advance();
                }
            }
            else if (isdigit(c)) {
                string num = "";
                while (getChar() != '\0' && isdigit(getChar())) {
                    num += getChar();
                    advance();
                }
                tokens.push_back(Token(INTEGER_LITERAL, num, line));
            }
            else if (isalpha(c) || c == '_') {
                string word = "";
                while (getChar() != '\0' && (isalnum(getChar()) || getChar() == '_')) {
                    word += getChar();
                    advance();
                }

                if (word == "integer") {
                    tokens.push_back(Token(INTEGER, "", line));
                }
                else if (word == "ptr") {
                    tokens.push_back(Token(PRINT, "", line));
                }
                else {
                    tokens.push_back(Token(IDENTIFIER, word, line));
                }
            }
            else if (c == ':') {
                tokens.push_back(Token(ASSIGNMENT, ":", line));
                advance();
            }
            else if (c == '+') {
                tokens.push_back(Token(PLUS, "+", line));
                advance();
            }
            else if (c == '-') {
                tokens.push_back(Token(MINUS, "-", line));
                advance();
            }
            else if (c == '*') {
                tokens.push_back(Token(MULTIPLY, "*", line));
                advance();
            }
            else if (c == '/') {
                tokens.push_back(Token(DIVIDE, "/", line));
                advance();
            }
            else if (c == '(') {
                tokens.push_back(Token(LEFT_PAREN, "(", line));
                advance();
            }
            else if (c == ')') {
                tokens.push_back(Token(RIGHT_PAREN, ")", line));
                advance();
            }
            else {
                cout << "LexerError: Illegal char '" << c << "' at line " << line << endl;
                break;
            }
        }

        tokens.push_back(Token(EOF_TOKEN, "", line));
        return tokens;
    }
};


// AST Node Classes (Parser er jonno)


// Base class for all nodes
class ASTNode {
public:
    virtual void print(int depth = 0) = 0;
    virtual ~ASTNode() {}
};

// Integer literal node (e.g., 10, 42)
class IntNode : public ASTNode {
public:
    string value;
    IntNode(string v) { value = v; }

    void print(int depth = 0) override {
        for (int i = 0; i < depth * 3; i++) cout << "-";
        cout << "IntNode: " << value << endl;
    }
};

// Identifier node (e.g., a, myVar)
class IdNode : public ASTNode {
public:
    string value;
    IdNode(string v) { value = v; }

    void print(int depth = 0) override {
        for (int i = 0; i < depth * 3; i++) cout << "-";
        cout << "IdNode: " << value << endl;
    }
};

// Binary operation node (e.g., a + b, c * 10)
class BinOpNode : public ASTNode {
public:
    ASTNode* left;
    string op;
    ASTNode* right;

    BinOpNode(ASTNode* l, string o, ASTNode* r) {
        left = l;
        op = o;
        right = r;
    }

    void print(int depth = 0) override {
        for (int i = 0; i < depth * 3; i++) cout << "-";
        cout << "BinOpNode: " << op << endl;
        left->print(depth + 1);
        right->print(depth + 1);
    }

    ~BinOpNode() {
        delete left;
        delete right;
    }
};


// Parser Class (Recursive Descent Parser)

class Parser {
public:
    vector<Token> tokens;
    int pos;

    Parser(vector<Token> t) {
        tokens = t;
        pos = 0;
    }

    // Current token dekhe
    Token currentTok() {
        if (pos < tokens.size()) {
            return tokens[pos];
        }
        return Token(EOF_TOKEN, "", 0);
    }

    // Porer token e jay
    void advance() {
        pos++;
    }

    
    // Grammar:
    // expr  -> term { (+ | -) term }
    // term  -> factor { (* | /) factor }
    // factor -> number | identifier | ( expr )
    

    // factor: number, identifier, ba (expr)
    ASTNode* factor() {
        Token tok = currentTok();

        // Integer literal (e.g., 10)
        if (tok.type_ == INTEGER_LITERAL) {
            advance();
            return new IntNode(tok.value);
        }
        // Identifier (e.g., a, myVar)
        else if (tok.type_ == IDENTIFIER) {
            advance();
            return new IdNode(tok.value);
        }
        // Parenthesized expression (e.g., (a + b))
        else if (tok.type_ == LEFT_PAREN) {
            advance();
            ASTNode* node = expr();
            if (currentTok().type_ == RIGHT_PAREN) {
                advance();
                return node;
            } else {
                cout << "ParseError: Expected ')' at line " << tok.line << endl;
                return node;
            }
        }
        else {
            cout << "ParseError: Unexpected token '" << tok.value << "' at line " << tok.line << endl;
            advance();
            return new IntNode("0");  // Error recovery
        }
    }

    // term: factor { (* | /) factor }
    ASTNode* term() {
        ASTNode* left = factor();

        while (currentTok().type_ == MULTIPLY || currentTok().type_ == DIVIDE) {
            string op = currentTok().type_;
            advance();
            ASTNode* right = factor();
            left = new BinOpNode(left, op, right);
        }

        return left;
    }

    // expr: term { (+ | -) term }
    ASTNode* expr() {
        ASTNode* left = term();

        while (currentTok().type_ == PLUS || currentTok().type_ == MINUS) {
            string op = currentTok().type_;
            advance();
            ASTNode* right = term();
            left = new BinOpNode(left, op, right);
        }

        return left;
    }

    // Main parse function
    ASTNode* parse() {
        return expr();
    }
};


// Main Function (Demo)

int main() {

    // Test expression
    string code = "a+b*c+(d-10)";

    cout << "========================================" << endl;
    cout << "   BANGLA COMPILER - LEXER + PARSER" << endl;
    cout << "========================================" << endl << endl;

    cout << "=== SOURCE CODE ===" << endl;
    cout << code << endl << endl;

    // Step 1: Lexical Analysis
    cout << "=== STEP 1: LEXICAL ANALYSIS (TOKENS) ===" << endl;
    Lexer lexer(code);
    vector<Token> tokens = lexer.tokenize();

    for (int i = 0; i < tokens.size(); i++) {
        tokens[i].print();
    }

    cout << endl;

    // Step 2: Parsing (AST Generation)
    cout << "=== STEP 2: PARSING (AST TREE) ===" << endl;
    Parser parser(tokens);
    ASTNode* ast = parser.parse();

    cout << "Abstract Syntax Tree:" << endl;
    ast->print();

    // Cleanup memory
    delete ast;

    cout << endl;
    cout << "=== COMPILER FRONTEND COMPLETE ===" << endl;

    return 0;
}
